{
  "version": "2.2",
  "description": "KIBO-RA v2 policy and mathematical configuration. Evidence extraction (lexical + semantic scoring, where semantic scoring is a hybrid concatenation of SBERT and BERT4RE embeddings) never uses expert labels.",
  "risk_thresholds": {
    "low": 0.4,
    "medium": 0.7
  },
  "gate_thresholds": {
    "compliance": 0.5,
    "ambiguity": 0.6,
    "confidence": 0.65
  },
  "semantic": {
    "enabled": true,
    "model": "all-mpnet-base-v2",
    "bert4re_model": "thearod5/bert4re",
    "bert4re_enabled": true,
    "hybrid_weights": {
      "sbert": 0.5,
      "bert4re": 0.5
    },
    "semantic_weight": 0.5,
    "lexical_weight": 0.5
  },
  "scoring": {
    "evidence_saturation": 2.5,
    "semantic_temperature": 0.2,
    "length_normalization_tokens": 20
  },
  "confidence": {
    "semantic_weight": 0.5,
    "evidence_weight": 0.3,
    "agreement_weight": 0.2
  }
}